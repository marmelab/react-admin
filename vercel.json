{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "framework": null,
    "buildCommand": "yarn build && yarn build-storybook",
    "outputDirectory": "storybook-static",
    "git": {
        "deploymentEnabled": {
            "gh-pages": false
        }
    },
    "ignoreCommand": "[ \"$VERCEL_GIT_COMMIT_REF\" != \"master\" ]"
}
